# ─────────────────────────────────────────────────────────────
# Swahili Dishes — Environment Variables
# Copy to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# App
COMPANY_NAME="Swahili Dishes"
SITE_NAME="Swahili Dishes"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# InsForge (Backend-as-a-Service)
INSFORGE_URL=""
INSFORGE_ANON_KEY=""
INSFORGE_API_KEY=""

# AI — DeepSeek (chatbot brain)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
AI_ASSISTANT_NAME="Sweya"

# Speech — Groq Whisper (voice-to-text, optional)
GROQ_API_KEY=""

# Payments — Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Payments — Safaricom Daraja (M-Pesa)
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_PASSKEY=""
DARAJA_SHORTCODE=""
DARAJA_CALLBACK_URL=""

# Web Scraping — Firecrawl (dish image search for chatbot + admin)
FIRECRAWL_API_KEY=""

# ─────────────────────────────────────────────────────────────
# CRM / Lead Generation
# ─────────────────────────────────────────────────────────────

WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="hello@swahlidishes.com"

TV_SIGNING_SECRET=""
ANALYTICS_ENABLED="false"
# LEAD_SCORE_WARM_THRESHOLD=21
# LEAD_SCORE_HOT_THRESHOLD=51
